NODE_ENV=development
PORT=4000

# MySQL connection string
DATABASE_URL="mysql://root:password@localhost:3306/dorm_system"

# JWT
JWT_SECRET="change_me_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend origin allowed for CORS
CORS_ORIGIN="http://localhost:3000"

# LINE Messaging API (Phase 6)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Billing (Phase 3)
WATER_PRICE_PER_UNIT=18
ELECTRICITY_PRICE_PER_UNIT=8
# ตั้งเป็น false เพื่อปิด cron ออกบิลอัตโนมัติ/คำนวณค่าปรับรายวัน
BILLING_SCHEDULER_ENABLED=true

# Receipt (Phase 4) — แสดงบนหัวใบเสร็จ PDF
RECEIPT_ISSUER_NAME="หอพักตัวอย่าง"
RECEIPT_ISSUER_ADDRESS="123 ถ.ตัวอย่าง แขวง/เขต กรุงเทพฯ 10000"
