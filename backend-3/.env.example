NODE_ENV=development
PORT=4000

# MySQL connection string
DATABASE_URL="mysql://root:password@localhost:3306/dorm_system"

# JWT
JWT_SECRET="change_me_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
